# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Required for /api/outfits (Gemini-generated outfit recommendations)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the default model used for outfit recommendations
GEMINI_MODEL=gemini-3.1-flash-lite
